# Bot Discord Decifrando
# Copie este arquivo para .env e preencha seus dados

# Token do Bot Discord
# Obtenha em: https://discord.com/developers/applications
DISCORD_TOKEN=seu_token_aqui

# Groq (opcional, mas recomendado) — sem isso, o bot só responde com o
# dicionário local (bem pequeno) e nunca responde pergunta solta de quiz.
# Com a chave configurada: desembaralha QUALQUER palavra (não só as do
# dicionário) e responde automaticamente mensagens que parecem quiz, mesmo
# sem comando. Gere sua chave grátis em: https://console.groq.com/keys
GROQ_API_KEY=sua_chave_groq_aqui

# Configuração da API Flask (opcional)
FLASK_ENV=development
FLASK_DEBUG=False
API_HOST=0.0.0.0
API_PORT=5000
