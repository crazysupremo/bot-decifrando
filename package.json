{
  "name": "bot-decifrando-desktop",
  "version": "1.0.0",
  "description": "Bot Decifrando — versão app de desktop (Electron por fora, Flask empacotado por dentro)",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.crazysupremo.botdecifrando",
    "productName": "Bot Decifrando",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "files": [
      "electron-main.js"
    ]
  }
}
